{
  "name": "nineforge",
  "version": "0.10.0",
  "private": false,
  "license": "MIT",
  "description": "Deterministic, fail-closed validation of CNC G-code against the real workcell before anything moves.",
  "keywords": [
    "cnc",
    "gcode",
    "g-code",
    "validation",
    "static-analysis",
    "sarif",
    "mcp",
    "manufacturing",
    "robotics",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arley100/nineforge.git"
  },
  "homepage": "https://github.com/Arley100/nineforge#readme",
  "bugs": "https://github.com/Arley100/nineforge/issues",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start",
    "build:lib": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "nf": "tsx cli/main.ts",
    "mcp": "tsx mcp/server.ts",
    "check:example": "tsx cli/main.ts check public/examples/bracket.nc --workcell public/examples/bracket.workcell.json --state public/examples/bracket.state.json --stress",
    "suite:example": "tsx cli/main.ts suite public/examples/suite.json",
    "demo:agent-loop": "tsx examples/agent-loop.ts",
    "prepublishOnly": "npm run build:lib"
  },
  "bin": {
    "nineforge": "./dist/cli.mjs",
    "nineforge-mcp": "./dist/mcp.mjs"
  },
  "main": "./dist/core/core.js",
  "module": "./dist/core/core.mjs",
  "types": "./dist/core/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/core.d.ts",
      "import": "./dist/core/core.mjs",
      "require": "./dist/core/core.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.6.2",
    "next": "^16.4.4",
    "postcss": "^8.5.32",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "tailwindcss": "^3.4.19",
    "three": "^0.187.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
